# ==============================================================================
# DevPulse Unified Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or configure backend/.env and frontend/.env respectively)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server & Network
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed frontend origins for CORS (comma-separated, no trailing slashes)
FRONTEND_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ------------------------------------------------------------------------------
# Local Docker Compose Replica Set:
# MONGODB_URI=mongodb://mongo:27017/devpulse?replicaSet=rs0
#
# Standalone Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/dev_community
#
# MongoDB Atlas Cloud Cluster:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dev_community?retryWrites=true&w=majority

# Dedicated Day 13 Ranking Seed Database (Isolated from primary database)
RANKING_SEED_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/devpulse_day13_seed?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. JWT Authentication & Security
# ------------------------------------------------------------------------------
# Access Token Secret & Expiration (Short-lived, e.g., 15m)
JWT_SECRET=replace_with_strong_random_access_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m

# Refresh Token Secret & Expiration (Long-lived, e.g., 7d)
# Stored only as SHA-256 hash digests in the database
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_jwt_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Initial Administrator Bootstrap Credentials
# ------------------------------------------------------------------------------
# Used by "npm run seed:admin" in backend/
ADMIN_NAME=DevPulse Administrator
ADMIN_EMAIL=admin@devpulse.io
ADMIN_PASSWORD=Admin@SecurePass2026

# ------------------------------------------------------------------------------
# 5. AI Post Summarizer (Groq Cloud API)
# ------------------------------------------------------------------------------
# If GROQ_API_KEY is empty or omitted, backend automatically falls back to MockSummarizerProvider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 6. Redis Configuration (BullMQ Queue)
# ------------------------------------------------------------------------------
# Docker Compose uses service name 'redis'
# Local development defaults to localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devpulse_redis_secret
# Alternatively, provide a full URL:
# REDIS_URL=redis://:devpulse_redis_secret@localhost:6379

# ------------------------------------------------------------------------------
# 7. Mail & SMTP Configuration
# ------------------------------------------------------------------------------
# Provider: 'console' (default, safe for local testing) or 'smtp'
MAIL_PROVIDER=console
MAIL_FROM=DevPulse <no-reply@devpulse.io>
FRONTEND_URL=http://localhost:3000

# SMTP settings (required when MAIL_PROVIDER=smtp)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# 8. Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# Public browser-facing API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Internal Docker/Server network URL for Next.js BFF SSR calls
BACKEND_INTERNAL_URL=http://localhost:5000
