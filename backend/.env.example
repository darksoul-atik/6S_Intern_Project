# Backend Server Configuration
PORT=5000

# Allowed frontend origins for CORS (separate multiple origins with commas)
FRONTEND_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# MongoDB Connection String (Mongoose)
# Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<appName>
# Local format: mongodb://localhost:27017/dev-community
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dev_community?retryWrites=true&w=majority

# Dedicated Day 13 ranking seed database
# IMPORTANT:
# - Must point to database name: devpulse_day13_seed
# - Never point this at the normal DevPulse database
# - Used only by ranking seed and cleanup scripts
RANKING_SEED_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/devpulse_day13_seed?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_access_token_secret_here
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Admin Bootstrap Credentials (for npm run seed:admin)
ADMIN_NAME=DevPulse Administrator
ADMIN_EMAIL=admin@devpulse.io
ADMIN_PASSWORD=your_secure_admin_password_here

# Groq AI summarizer
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Redis Configuration (BullMQ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devpulse_redis_secret
# REDIS_URL=redis://:devpulse_redis_secret@localhost:6379

# Mail Configuration
MAIL_PROVIDER=console
MAIL_FROM=DevPulse <no-reply@devpulse.io>
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# GitHub Changelog Integration (auto | github-app | mock)
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_INSTALLATION_ID=169547332
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
CHANGELOG_REPO=darksoul-atik/6S_Intern_Project
CHANGELOG_PROVIDER=auto